# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
HOSPITAL_NAME=[HOSPITAL NAME]
HOSPITAL_NUMBER_PREFIX=HN

POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Production (docker-compose.prod.yml) ----
# The owner account changes the database structure. The website runs as POSTGRES_USER, which has fewer rights.
POSTGRES_OWNER_USER=hms_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
# (POSTGRES_USER / POSTGRES_PASSWORD above become the limited website account: use hms_app and a new password.)
HMS_HOST=hms.hospital.local
BACKUP_DIR_HOST=/mnt/second-disk/hms-backups
BACKUP_KEY_FILE_HOST=/etc/hms/backup.key
# BACKUP_COPY_COMMAND runs INSIDE the worker container, where rclone is not installed. Copy the backup folder to the
# cloud from the host instead (a cron job running rclone), or install your copy tool in the image first.
# BACKUP_COPY_COMMAND=
ALERT_EMAILS=it@hospital.example
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# ALERT_SMS_WEBHOOK=https://sms-gateway.example/send
# ALERT_SMS_NUMBERS=+2547XXXXXXXX
# Sync to the cloud copy (leave empty until the cloud copy exists):
# SYNC_CLOUD_URL=https://hms-cloud.example.org
# SYNC_TOKEN=a-long-random-shared-secret
# MPESA_CALLBACK_SECRET=
# SHA claims carry the hospital's facility code:
# HOSPITAL_FACILITY_CODE=
# M-Pesa STK Push (prompt-to-pay). All of these must be set to switch it on:
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_STK_CALLBACK_BASE=https://hms.example.org
# MPESA_STK_CALLBACK_SECRET=a-long-random-string
