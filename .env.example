DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=hms.local,localhost
DJANGO_CSRF_ORIGINS=https://hms.local
# Set to false only while testing on plain HTTP inside the hospital LAN
DJANGO_SSL_REDIRECT=true
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
HOSPITAL_NAME=[HOSPITAL NAME]
SMS_BACKEND=apps.appointments.sms.ConsoleSMSBackend

# Hosted setup (Vercel + Supabase): use the Supabase *pooler* connection string, then you can ignore POSTGRES_*
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
