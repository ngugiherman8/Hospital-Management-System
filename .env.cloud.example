# Copy to .env.cloud on the cloud server. Never commit it.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-a-long-random-value
DJANGO_ALLOWED_HOSTS=hms-cloud.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://hms-cloud.example.org
HOSPITAL_NAME=[HOSPITAL NAME] (cloud copy)
HMS_HOST=hms-cloud.example.org
POSTGRES_DB=hms
POSTGRES_OWNER_USER=hms_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_USER=hms_app
POSTGRES_PASSWORD=change-me-too
SYNC_TOKEN=the-same-long-random-shared-secret-as-the-hospital-server
